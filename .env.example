# Same Supabase project as the public app. Anon key only — this admin area has
# no service_role key on purpose; access is enforced by RLS plus
# profiles.is_superadmin.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Server-only, for generating new house captions from the admin area.
GEMINI_API_KEY=your-google-ai-studio-key
GEMINI_MODEL=gemini-3.6-flash
